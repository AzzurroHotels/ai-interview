PORT=3000
RESEND_API_KEY=re_dummy_account_suspended_replace_before_enable
FROM_EMAIL=careers@azzurrohotels.com
CAREERS_EMAIL=careers@azzurrohotels.com
UPLOAD_DIR=./uploads
# Admin panel login (cookie session, 12h)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Minutes without a heartbeat before an in-progress interview is shown as abandoned
ABANDON_AFTER_MINUTES=3

# Speech-to-text (Groq Whisper)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
# Auto-grading LLM: "groq" (default, uses GROQ_API_KEY) or "deepseek"
GRADING_PROVIDER=groq
GROQ_GRADING_MODEL=openai/gpt-oss-120b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Video transcription needs ffmpeg on the server; audio-only works without it
FFMPEG_BIN=ffmpeg
